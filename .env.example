# Variables workflows can read as {{env.NAME}} must be prefixed REQORA_ENV_.
# The seeded checkout workflow's demo Stripe node needs any bearer token:
REQORA_ENV_STRIPE_SECRET=sk_test_demo_only

# Optional: SQLite file location (default .data/reqora.db)
# REQORA_DB_PATH=.data/reqora.db

# Master key that encrypts stored secrets (32 bytes as 64 hex chars). Required when NODE_ENV=production
# (`npm start`); in `npm run dev` a key is generated into .data/secret.key if this is unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQORA_SECRET_KEY=

# Sign-up is open only until the first account exists. Set to true to let anyone with access to the
# login page create an account. Otherwise add users with: npm run user -- create <email> "<name>"
# REQORA_ALLOW_SIGNUP=true

# Hostnames other than localhost that open `npm run dev` (e.g. a Cloudflare tunnel), comma-separated,
# without scheme or port. Not needed for `npm start`.
# REQORA_DEV_ORIGINS=reqora.example.com

# Outbound network policy. Sends, workflow HTTP nodes and load tests may not reach loopback or private
# networks (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) unless listed here: comma-separated CIDRs,
# host names (api.internal, *.corp.example) or "private" for all of them. Link-local and cloud metadata
# (169.254.0.0/16) are always blocked. Reqora's own origin (relative URLs) is always allowed.
# REQORA_ALLOW_NETWORKS=10.20.0.0/16,api.internal
